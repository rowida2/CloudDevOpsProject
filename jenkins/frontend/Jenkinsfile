@Library('ivolve-shared-lib') _

pipeline {
    agent any

    environment {
        SERVICE   = 'frontend'
        MANIFEST  = 'k8s/frontend-deployment.yaml'
        REGISTRY  = '<ACCOUNT_ID>.dkr.ecr.eu-central-1.amazonaws.com/ivolve'
        REGION    = 'eu-central-1'
        REPO_URL  = 'https://github.com/rowida2/CloudDevOpsProject.git'
        TAG       = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Build Image')      { steps { buildImage(env.SERVICE, env.TAG, "./${env.SERVICE}") } }
        stage('Scan Image')       { steps { scanImage(env.SERVICE, env.TAG) } }
        stage('Push Image')       { steps { pushImage(env.SERVICE, env.TAG, env.REGISTRY, env.REGION) } }
        stage('Delete Image')     { steps { deleteImage(env.SERVICE, env.TAG, env.REGISTRY) } }
        stage('Update Manifests') { steps { updateManifests(env.MANIFEST, "${env.REGISTRY}/${env.SERVICE}:${env.TAG}") } }
        stage('Push Manifests')   { steps { pushManifests(env.REPO_URL, 'main', "ci: update ${env.SERVICE} image to ${env.TAG}") } }
    }
}